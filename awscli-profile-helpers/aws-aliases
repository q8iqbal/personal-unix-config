#!/usr/bin/env bash
# AWS resource listing aliases

alias aws-ec2ls='aws ec2 describe-instances --query "Reservations[].Instances[].{InstanceId:InstanceId,Name:Tags[?Key==\`Name\`]|[0].Value,IP:PrivateIpAddress,Type:InstanceType,Status:State.Name,SecurityGroups:join(\`,\`,SecurityGroups[].GroupId)}" --output table'
aws-sgrules() {
  if [ -z "$1" ]; then
    echo "Usage: aws-sgrules <sg-id>"
    return 1
  fi
  echo "=== Inbound Rules (sg: $1) ==="
  aws ec2 describe-security-groups --group-ids "$1" \
    --query "SecurityGroups[].IpPermissions[].{Protocol:IpProtocol,FromPort:FromPort,ToPort:ToPort,Source:join(\`,\`,IpRanges[].CidrIp||[\`\`]),SourceSG:join(\`,\`,UserIdGroupPairs[].GroupId||[\`\`])}" \
    --output table
  echo ""
  echo "=== Outbound Rules (sg: $1) ==="
  aws ec2 describe-security-groups --group-ids "$1" \
    --query "SecurityGroups[].IpPermissionsEgress[].{Protocol:IpProtocol,FromPort:FromPort,ToPort:ToPort,Destination:join(\`,\`,IpRanges[].CidrIp||[\`\`]),DestSG:join(\`,\`,UserIdGroupPairs[].GroupId||[\`\`])}" \
    --output table
}

alias aws-rdsls='aws rds describe-db-instances --query "DBInstances[*].[DBInstanceIdentifier,DBInstanceClass,Engine,DBInstanceStatus,Endpoint.Address]" --output table'
alias aws-vpcls='aws ec2 describe-vpcs --query "Vpcs[].{VpcId:VpcId,Name:Tags[?Key==\`Name\`]|[0].Value,CIDR:CidrBlock,State:State}" --output table'
alias aws-subnetls='aws ec2 describe-subnets --query "Subnets[].{SubnetId:SubnetId,Name:Tags[?Key==\`Name\`]|[0].Value,VpcId:VpcId,CIDR:CidrBlock,AZ:AvailabilityZone}" --output table'
alias aws-elasticachels='aws elasticache describe-cache-clusters --show-cache-node-info --query "CacheClusters[].{ClusterId:CacheClusterId,Engine:Engine,NodeType:CacheNodeType,Status:CacheClusterStatus,Nodes:NumCacheNodes,Endpoint:ConfigurationEndpoint.Address||CacheNodes[0].Endpoint.Address}" --output table'

aws-eksngls() {
  for cluster in $(aws eks list-clusters --query "clusters[]" --output text); do
    for ng in $(aws eks list-nodegroups --cluster-name "$cluster" --query "nodegroups[]" --output text); do
      aws eks describe-nodegroup --cluster-name "$cluster" --nodegroup-name "$ng" \
        --query "nodegroup.{Cluster:clusterName,NodeGroup:nodegroupName,Status:status,InstanceType:instanceTypes[0],Desired:scalingConfig.desiredSize,Min:scalingConfig.minSize,Max:scalingConfig.maxSize,AMI:amiType,K8sVersion:version}" \
        --output table
    done
  done
}